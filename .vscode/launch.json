{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "DisasterHazardSystemApp",
      "request": "launch",
      "mainClass": "DisasterHazardSystemApp",
      "projectName": "ai-disaster-hazard-detection"
    },
    {
      "type": "java",
      "name": "SAGIP",
      "request": "launch",
      "mainClass": "SAGIP"
    },
    {
      "name": "Run Java App via Maven",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "clean",
        "compile",
        "exec:java"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Run Web App (npm run dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "console": "integratedTerminal"
    }
  ]
}
